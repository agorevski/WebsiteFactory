{
  "name": "website-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test scripts/*.test.mjs packages/validation/tests/*.test.mjs && npm run test --workspaces --if-present",
    "lint": "echo \"No linting configured yet.\"",
    "validate": "npm run build && npm run typecheck && npm test && npm run lint && npm run validate:examples",
    "validate:examples": "npm run validate:examples --workspace @website-factory/website-builder",
    "qa:generated:build": "npm run build",
    "qa:generated:serve": "npm run preview --workspace @website-factory/website-builder -- --host 127.0.0.1 --port 4173",
    "qa:generated:lhci": "node scripts/run-lhci.mjs",
    "qa:generated:playwright": "node scripts/playwright-axe-smoke.mjs",
    "qa:generated:static": "node scripts/validate-static-site.mjs --skip-html-validator",
    "qa:generated:html": "node scripts/validate-static-site.mjs --skip-linkinator",
    "qa:generated:dist": "node scripts/validate-generated-dist.mjs",
    "qa:generated:visual": "node scripts/playwright-axe-smoke.mjs --max-pages=25 --viewport=390x844 --screenshot-dir=.website-factory-qa/screenshots --fail-on-horizontal-overflow --allow-crawl-limit --skip-axe",
    "qa:templates:registry": "node scripts/validate-template-registry.mjs",
    "qa:templates:fuzz": "node --test scripts/template-fuzz.test.mjs",
    "qa:templates": "npm run qa:templates:registry && npm run qa:templates:fuzz",
    "qa:generated": "npm run qa:generated:build && npm run qa:generated:dist && start-server-and-test \"npm run qa:generated:serve\" http://127.0.0.1:4173 \"npm run qa:generated:lhci && npm run qa:generated:playwright && npm run qa:generated:visual && npm run qa:generated:static\"",
    "qa:generated:report": "./scripts/run-generated-qa.sh",
    "clean": "rm -rf dist .astro apps/*/dist apps/*/.astro packages/*/dist packages/*/*.tsbuildinfo",
    "regenerate:websites": "./scripts/regenerate-websites.sh"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.1",
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.6",
    "fast-check": "^4.3.0",
    "html-validator-cli": "^7.0.1",
    "linkinator": "^7.6.1",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
